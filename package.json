{
  "name": "shoppr",
  "version": "0.1.0",
  "description": "Shopping data for AI agents — a CLI that fetches product details, prices, reviews, seller offers and search/category listings from online stores (Allegro first; Amazon/Ceneo pluggable later). Ships a Claude/Cursor/Codex skill.",
  "type": "module",
  "bin": {
    "shoppr": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "prepare": "tsc",
    "build": "tsc",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "shopping",
    "allegro",
    "ecommerce",
    "ai",
    "agent",
    "skill",
    "claude",
    "scraper",
    "cli",
    "reviews",
    "prices"
  ],
  "author": "Victor Naumik",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.2.3",
    "ora": "^9.3.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
